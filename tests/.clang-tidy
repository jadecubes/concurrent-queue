---
InheritParentConfig: true
CheckOptions:
  # Test-only relaxation: the short names actually used by these tests
  # (queue, loop index, thread handle, producer index). Child CheckOptions
  # replace the parent's value rather than extend it.
  readability-identifier-length.IgnoredVariableNames: '^(q|i|t)$'
  readability-identifier-length.IgnoredParameterNames: '^p$'
