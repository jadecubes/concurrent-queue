---
InheritParentConfig: true
CheckOptions:
  # Test-only relaxation: these short names are idiomatic in tests (queue,
  # producer/consumer indices, thread handles). Child CheckOptions replace the
  # parent's value, so `_` is re-listed.
  readability-identifier-length.IgnoredVariableNames: '^(_|q|p|c|i|t)$'
  readability-identifier-length.IgnoredParameterNames: '^(p|c|i)$'
